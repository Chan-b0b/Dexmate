\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Contact force on the robot: one representative trial per policy, aligned at peak force ($t{=}0$), over the interaction window (before lift, where carrying the case would re-enter payload weight into the measured force). The naive attempt rises through the demonstrated range and is terminated by the external $15$\,N abort ($\times $; all three naive attempts end this way, at $15.4$--$18.7$\,N), while the conditioned pick presses to $2.5$\,N---the median of its nine picks across three stack heights, one of them absent from the demonstrations---and stops on its own.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:forcetraces}{{3}{6}{Contact force on the robot: one representative trial per policy, aligned at peak force ($t{=}0$), over the interaction window (before lift, where carrying the case would re-enter payload weight into the measured force). The naive attempt rises through the demonstrated range and is terminated by the external $15$\,N abort ($\times $; all three naive attempts end this way, at $15.4$--$18.7$\,N), while the conditioned pick presses to $2.5$\,N---the median of its nine picks across three stack heights, one of them absent from the demonstrations---and stops on its own}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces On-robot counterfactuals (P5): identical frozen observations, wrench transplanted to a fixed normal-force dose (circles: ten-pose session; squares: three-pose session; faint dots: individual poses). (a)~The response ordering reverses between $6$ and $9$\,N---the offline crossover on the physical system. (b)~FiLM modulation magnitude rises monotonically with dose.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:live}{{4}{7}{On-robot counterfactuals (P5): identical frozen observations, wrench transplanted to a fixed normal-force dose (circles: ten-pose session; squares: three-pose session; faint dots: individual poses). (a)~The response ordering reverses between $6$ and $9$\,N---the offline crossover on the physical system. (b)~FiLM modulation magnitude rises monotonically with dose}{figure.4}{}}
