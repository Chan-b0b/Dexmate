# cp .env.example .env  — docker compose reads it automatically (optional).

# Where datasets / outputs / logs / the HF cache live on the host. Mounted at
# /data001/maverick inside the container, which is what the datasets|outputs|logs
# symlinks in vla_training/ point at. Needs ~100 GB+ (12 GB datasets, 57 GB HF cache,
# checkpoints on top). Must be owned by your uid before the first start.
HOST_DATA_ROOT=/data001/maverick

# Host uid/gid to run as, so files written to the mounts stay yours. Build args.
UID=1007
GID=1007

TENSORBOARD_PORT=6006

# Optional. Alternative to `hf auth login` (which persists on the data volume).
# HF_TOKEN=hf_...
# WANDB_API_KEY=...
